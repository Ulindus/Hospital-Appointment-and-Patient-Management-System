@{
    ViewData["Title"] = "About Us";
}

<!-- HERO -->
<section class="about-hero">
    <div class="container">
        <h1>About Our Hospital System</h1>
        <p>
            A modern digital solution designed to improve hospital operations,
            reduce patient waiting time, and enhance healthcare delivery.
        </p>
    </div>
</section>

<!-- MAIN CONTENT -->
<section class="about-content">
    <div class="container">

        <!-- WHO WE ARE -->
        <div class="row mb-5">
            <div class="col-md-6">
                <h3>Who We Are</h3>
                <p>
                    The Hospital Appointment and Patient Management System is a web-based
                    application developed to simplify the process of managing patients,
                    doctors, and appointments in hospitals and clinics.
                </p>
                <p>
                    Our system helps healthcare institutions move away from manual
                    paperwork and adopt a reliable, secure, and efficient digital platform.
                </p>
            </div>

            <div class="col-md-6">
                <h3>Why This System?</h3>
                <p>
                    Traditional hospital appointment systems often cause long waiting times,
                    scheduling conflicts, and poor patient experience.
                </p>
                <p>
                    This system provides real-time appointment booking, role-based dashboards,
                    and better communication between patients, doctors, and administrators.
                </p>
            </div>
        </div>

        <!-- MISSION / VISION -->
        <div class="row mb-5">
            <div class="col-md-6">
                <div class="about-card">
                    <h5>Our Mission</h5>
                    <p>
                        To improve healthcare efficiency by providing a smart appointment
                        management system that saves time for both patients and medical staff.
                    </p>
                </div>
            </div>

            <div class="col-md-6">
                <div class="about-card">
                    <h5>Our Vision</h5>
                    <p>
                        To become a reliable digital healthcare solution that supports hospitals
                        in delivering faster, organized, and patient-friendly services.
                    </p>
                </div>
            </div>
        </div>

        <!-- SYSTEM ROLES -->
        <div class="row">
            <div class="col-md-4">
                <div class="about-card">
                    <h5>Admin</h5>
                    <p>
                        Manages doctors, patients, appointments, and system data.
                        Has full control over hospital operations.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-card">
                    <h5>Doctor</h5>
                    <p>
                        Views daily appointments, manages availability,
                        and updates appointment status efficiently.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="about-card">
                    <h5>Patient</h5>
                    <p>
                        Views doctors, books appointments, receives queue numbers,
                        and manages their appointments easily.
                    </p>
                </div>
            </div>
        </div>

    </div>
</section>
