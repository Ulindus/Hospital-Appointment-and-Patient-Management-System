@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Hospital Appointment System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        .hero {
            min-height: 100vh;
            width: 100%;
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1576765607924-b6b56f3f6b88');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: white;
        }

            .hero h1 {
                font-size: 3rem;
                font-weight: 700;
            }

            .hero p {
                font-size: 1.2rem;
                max-width: 700px;
                margin: 20px auto;
            }
    </style>
</head>

<body>
    <div class="hero">
        <div>
            <h1>Hospital Appointment & Patient Management</h1>
            <p>
                A modern platform to book appointments, manage patients,
                and streamline hospital operations.
            </p>

            <a asp-controller="Account"
               asp-action="Login"
               class="btn btn-primary btn-lg px-5 mt-3">
                Get Started
            </a>
        </div>
    </div>
</body>
</html>
