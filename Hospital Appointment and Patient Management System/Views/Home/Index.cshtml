@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <div class="hero-content">
        <h1>
            Hospital Appointment <br />
            & Patient Management System
        </h1>

        <p>
            Book appointments, manage doctors, and streamline hospital operations
            with a modern digital solution.
        </p>

        <div class="hero-actions">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">
                Get Started
            </a>
          
        </div>
    </div>

    <div class="hero-image">
        <img src="~/images/healthcare-team.png" alt="Hospital Team">
    </div>
</section>

<section class="features">
    <h2>Key Features</h2>

    <div class="feature-grid">
        <div class="feature-card">
            <h5>📅 Online Appointments</h5>
            <p>Book and cancel appointments anytime.</p>
        </div>

        <div class="feature-card">
            <h5>👨‍⚕️ Doctor Management</h5>
            <p>Manage schedules, availability, and specialization.</p>
        </div>

        <div class="feature-card">
            <h5>📊 Admin Dashboard</h5>
            <p>Full control over hospital operations.</p>
        </div>
    </div>
</section>

<section class="cta">
    <h2>Ready to Get Started?</h2>
    <p>Login now and manage hospital appointments efficiently.</p>
    <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg">
        Get Started
    </a>
</section>
