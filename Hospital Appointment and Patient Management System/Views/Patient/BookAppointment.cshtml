@model List<Hospital_Appointment_and_Patient_Management_System.Models.DoctorSchedule>
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Book Appointment";
}

<div class="container mt-4">
    <h3 class="fw-bold mb-3">📅 Book Appointment</h3>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Specialization</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No schedules available
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model)
                        {
                            <tr>
                                <td>@s.Doctor.Name</td>
                                <td>@s.Doctor.Specialization</td>
                                <td>@s.Date.ToString("yyyy-MM-dd")</td>
                                <td>@s.TimeSlot</td>
                                <td>
                                    <form asp-action="CreateAppointment" method="post">
                                        <input type="hidden" name="scheduleId" value="@s.DoctorScheduleId" />
                                        <button class="btn btn-success btn-sm">
                                            Book
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
