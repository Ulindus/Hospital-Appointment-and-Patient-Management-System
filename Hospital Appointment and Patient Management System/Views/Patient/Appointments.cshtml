@model List<Hospital_Appointment_and_Patient_Management_System.Models.Appointment>
@{
    Layout = "~/Views/Shared/_PatientLayout.cshtml";
    ViewData["Title"] = "Book Appointment";
}

<div class="container mt-4">
    <h3 class="mb-3">📋 My Appointments</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Doctor</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.Doctor.Name</td>
                    <td>@a.Date.ToString("yyyy-MM-dd")</td>
                    <td>@a.Time</td>
                    <td>@a.Status</td>
                    <td>
                        @if (a.Status != "Cancelled")
                        {
                            <form asp-action="CancelAppointment" method="post">
                                <input type="hidden" name="id" value="@a.AppointmentId" />
                                <button class="btn btn-danger btn-sm">
                                    Cancel
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
