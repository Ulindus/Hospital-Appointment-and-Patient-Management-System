@{
    ViewData["Title"] = "Appointment Booked";
}

<div class="container mt-5">
    <div class="card shadow p-4 text-center">
        <h2 class="text-success">✅ Appointment Booked Successfully</h2>

        <p class="mt-3 fs-5">
            Your Appointment Number is:
        </p>

        <h1 class="text-primary fw-bold">
            @ViewBag.AppointmentNumber
        </h1>

        <p class="mt-3 text-muted">
            Please keep this number for reference.
        </p>

        <a asp-controller="Patient"
           asp-action="Appointments"
           class="btn btn-primary mt-3">
            View My Appointments
        </a>
    </div>
</div>
