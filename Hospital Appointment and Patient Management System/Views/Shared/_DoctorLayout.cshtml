<!DOCTYPE html>
<html>
<head>
    <title>Doctor Panel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        .container-fluid {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 230px;
            background: #0d6efd;
            color: white;
            padding: 20px;
        }

            .sidebar a {
                color: white;
                display: block;
                padding: 10px;
                text-decoration: none;
                border-radius: 5px;
            }

                .sidebar a:hover {
                    background: rgba(255,255,255,0.2);
                }

        .content {
            flex: 1;
            padding: 30px;
            background: #f8f9fa;
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="sidebar">
            <h4>Doctor Panel</h4>
            <a asp-controller="Doctor" asp-action="Index">Dashboard</a>
            <a asp-controller="Doctor" asp-action="Appointments">My Appointments</a>
            <a asp-controller="Doctor" asp-action="Schedule">Schedule</a>
            <a asp-controller="Account" asp-action="Logout">Logout</a>
        </div>

        <div class="content">
            @RenderBody()
        </div>
    </div>

</body>
</html>
