<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            background-color: #ffffff;
            border-right: 1px solid #ddd;
            padding: 20px;
        }

        .sidebar h4 {
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            padding: 10px 15px;
            margin-bottom: 10px;
            text-decoration: none;
            color: #333;
            border-radius: 6px;
        }

        .sidebar a:hover {
            background-color: #f0f0f0;
        }

        .sidebar a.active {
            background-color: #0d6efd;
            color: white;
        }

        .content {
            flex: 1;
            padding: 30px;
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>

    <div class="admin-container">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <h4>🏥 Hospital</h4>

            <a asp-controller="Admin" asp-action="Index">Dashboard</a>
            <a asp-controller="Admin" asp-action="Patients">Patients</a>
            <a asp-controller="Admin" asp-action="Doctors">Doctors</a>
            <a asp-controller="Admin" asp-action="Appointments">Appointments</a>
            <a asp-controller="Admin" asp-action="Schedule">Schedule</a>
            <a asp-controller="Admin" asp-action="Reports">Reports</a>

            <hr />

            <a asp-controller="Account" asp-action="Logout" style="color:red;">
                Logout
            </a>
        </div>

        <!-- MAIN CONTENT -->
        <div class="content">
            @RenderBody()
        </div>

    </div>

</body>
</html>
