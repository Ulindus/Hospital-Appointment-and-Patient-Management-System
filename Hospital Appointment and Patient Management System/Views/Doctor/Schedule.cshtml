@model Hospital_Appointment_and_Patient_Management_System.Models.Doctor

@{
    ViewData["Title"] = "Doctor Schedule";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0">
                <div class="card-body p-4">

                    <h3 class="text-center mb-4">
                        🗓️ Set Your Availability
                    </h3>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success text-center">
                            @TempData["Success"]
                        </div>
                    }

                    @{
                        var selectedDays = Model?.AvailableDays?.Split(", ") ?? new string[] { };
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <!-- Available Days -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Available Days
                            </label>

                            <div class="row">
                                @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" })
                                {
                                    <div class="col-6">
                                        <div class="form-check mb-2">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="AvailableDays"
                                                   value="@day"
                                                   id="@day"
                                                   @(selectedDays.Contains(day) ? "checked" : "") />
                                            <label class="form-check-label" for="@day">
                                                @day
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Available Time -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Available Time
                            </label>
                            <input type="text"
                                   name="AvailableTime"
                                   class="form-control"
                                   value="@Model?.AvailableTime"
                                   placeholder="09:00 AM - 05:00 PM"
                                   required />
                        </div>

                        <!-- Button -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                💾 Save Schedule
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
