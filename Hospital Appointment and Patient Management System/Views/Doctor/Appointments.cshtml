@model List<Hospital_Appointment_and_Patient_Management_System.Models.Appointment>

@{
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<h3>My Appointments</h3>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Patient</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Date.ToShortDateString()</td>
                <td>@a.Time</td>
                <td>@a.Patient.Name</td>
                <td>@a.Status</td>
            </tr>
        }
    </tbody>
</table>
