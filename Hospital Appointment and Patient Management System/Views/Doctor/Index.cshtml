@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<div class="container mt-4">

    <!-- Welcome Card -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body d-flex align-items-center">
            <div class="me-3 fs-1">👨‍⚕️</div>
            <div>
                <h4 class="mb-1">Welcome, Doctor</h4>
                <p class="text-muted mb-0">
                    Manage your schedule, appointments, and availability
                </p>
            </div>
        </div>
    </div>

    <!-- Action Cards -->
    <div class="row g-4">

        <!-- Appointments -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-3 text-primary">📅</div>
                    <h5 class="card-title">My Appointments</h5>
                    <p class="text-muted">
                        View all your patient appointments
                    </p>
                    <a asp-action="Appointments" class="btn btn-outline-primary">
                        View Appointments
                    </a>
                </div>
            </div>
        </div>

        <!-- Schedule -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body text-center">
                    <div class="fs-1 mb-3 text-success">🗓️</div>
                    <h5 class="card-title">My Schedule</h5>
                    <p class="text-muted">
                        Set your available days and time
                    </p>
                    <a asp-action="Schedule" class="btn btn-outline-success">
                        Set Schedule
                    </a>
                </div>
            </div>
        </div>

        

    </div>
</div>
